# Sauvegarde nocturne de la base (ticket #15) : pg_dump (format custom),
# chiffré en flux par age vers la clé publique du porteur, envoyé dans le
# compartiment Object Storage des sauvegardes, puis suppression de celles
# de plus de 30 jours. Lancé par diguee-sauvegarde.timer. En cas d'échec :
# alerte au journal (diguee-alerte@) et dans l'espace équipe (fichier d'état).
[Unit]
Description=Diguee : sauvegarde chiffrée de la base (pg_dump, age, Object Storage)
Documentation=https://github.com/2guntan/diguee/blob/main/deploiement/README.md
Wants=network-online.target
After=network-online.target diguee-volume.service postgresql@16-main.service
Requires=diguee-volume.service postgresql@16-main.service
OnFailure=diguee-alerte@%n.service

[Service]
Type=oneshot
# Utilisateur système dédié, sans shell : « peer » → rôle diguee_sauvegarde
# (lecture seule, pg_read_all_data). Il ne lit ni diguee.env ni les
# certificats du KMS.
User=diguee-sauvegarde
Group=diguee-sauvegarde
# Clé d'accès S3 du compartiment des sauvegardes : root 0600, lu par systemd.
EnvironmentFile=/etc/diguee/sauvegarde.env
# Réglages fixes (Environment= est écrasé par EnvironmentFile= : ces
# variables ne doivent pas figurer dans sauvegarde.env).
Environment=DIGUEE_ENV=production
Environment=DIGUEE_SAUVEGARDE_POSTGRES_URL=postgres://diguee_sauvegarde@/diguee?host=/var/run/postgresql
Environment=DIGUEE_SAUVEGARDE_PG_DUMP=/usr/lib/postgresql/16/bin/pg_dump
Environment=DIGUEE_SAUVEGARDE_AGE=/usr/bin/age
# Clé publique age (jamais la clé privée) : remise par systemd.
LoadCredential=sauvegarde.age.pub:/etc/diguee/sauvegarde.age.pub
Environment=DIGUEE_SAUVEGARDE_CLE_PUBLIQUE=%d/sauvegarde.age.pub
# Fichier d'état lu par le serveur (espace équipe) : 0755 / 0644, sans secret.
StateDirectory=diguee-sauvegarde
StateDirectoryMode=0755
Environment=DIGUEE_SAUVEGARDE_ETAT=%S/diguee-sauvegarde/etat.json
ExecStart=/opt/diguee/diguee sauvegarde faire
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
SyslogIdentifier=diguee-sauvegarde

# Durcissement. Le seul fichier écrit hors de l'état est la sauvegarde
# chiffrée, dans le /tmp privé de l'unité, effacée après l'envoi.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077
