# Migrations du schéma, avec le rôle propriétaire (diguee_proprietaire),
# puis droits exacts du rôle de l'application. Lancé par diguee-installer
# avant chaque redémarrage de diguee.service ; jamais au démarrage de la
# machine. Utilisateur système distinct (diguee-migrations), seul à pouvoir
# se connecter comme propriétaire (authentification « peer », pg_ident.conf).
[Unit]
Description=Diguee : migrations du schéma (rôle propriétaire)
After=diguee-volume.service postgresql@16-main.service
Requires=diguee-volume.service postgresql@16-main.service

[Service]
Type=oneshot
User=diguee-migrations
Group=diguee-migrations
EnvironmentFile=/etc/diguee/diguee.env
EnvironmentFile=/etc/diguee/migrations.env
Environment=DIGUEE_ENV=production
Environment=DIGUEE_TLS=acme
Environment=DIGUEE_OVH_KMS_CERTIFICAT=%d/kms-client.pem
Environment=DIGUEE_OVH_KMS_CLE_CLIENT=%d/kms-client.key
ExecStart=/opt/diguee/diguee migrer
SyslogIdentifier=diguee-migrer

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077
