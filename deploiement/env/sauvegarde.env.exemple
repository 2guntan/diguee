# /etc/diguee/sauvegarde.env : environnement de diguee-sauvegarde.service
# (root 0600, lu par systemd seulement). Compartiment Object Storage dédié
# aux sauvegardes, distinct de diguee-archives, avec sa propre clé d'accès
# (écriture, liste et suppression ; pas de lecture) : docs/À faire par le
# porteur.md §1.4. La base, pg_dump, age, la clé publique et le fichier
# d'état sont fixés par l'unité.
DIGUEE_SAUVEGARDE_STOCKAGE=ovh
DIGUEE_SAUVEGARDE_S3_POINT_ACCES=https://s3.gra.io.cloud.ovh.net
DIGUEE_SAUVEGARDE_S3_REGION=gra
DIGUEE_SAUVEGARDE_S3_COMPARTIMENT=diguee-sauvegardes
DIGUEE_SAUVEGARDE_S3_CLE_ACCES=À COMPLÉTER
DIGUEE_SAUVEGARDE_S3_CLE_SECRETE=À COMPLÉTER
# Facultatif : durée maximale d'un appel (envoi compris).
#DIGUEE_SAUVEGARDE_S3_DELAI=1h
