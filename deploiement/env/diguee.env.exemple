# /etc/diguee/diguee.env : environnement de diguee.service (root 0600, lu
# par systemd, jamais par le service). Liste complète des variables : README
# du dépôt ; ce qu'il faut demander à qui : docs/À faire par le porteur.md.
# DIGUEE_ENV, DIGUEE_TLS, DIGUEE_ACME_CACHE et le certificat du KMS sont
# fixés par l'unité systemd.

# Base : rôle de l'application, par le socket Unix, sans mot de passe
# (authentification « peer » : utilisateur système diguee → diguee_app).
DIGUEE_POSTGRES_URL=postgres://diguee_app@/diguee?host=/var/run/postgresql

# HTTPS (Let's Encrypt) : nom du certificat = celui de l'adresse publique.
DIGUEE_URL_PUBLIQUE=https://consultation.diguee.sn
# Facultatif : contact du compte ACME.
#DIGUEE_ACME_COURRIEL=technique@diguee.sn

# Empreinte (§1.1) : KMS d'OVHcloud.
DIGUEE_EMPREINTEUR=ovh
DIGUEE_OVH_KMS_POINT_ACCES=https://eu-west-par.okms.ovh.net
DIGUEE_OVH_KMS_ID=À COMPLÉTER
DIGUEE_OVH_KMS_CLE_ID=À COMPLÉTER

# Secrets (§1.7, §1.8) : 64 chiffres hexadécimaux chacun (openssl rand -hex 32).
DIGUEE_CLE_TOTP=À COMPLÉTER
DIGUEE_CLE_ALTCHA=À COMPLÉTER

# WhatsApp (§1.5).
DIGUEE_WHATSAPP=meta
DIGUEE_META_ID_NUMERO=À COMPLÉTER
DIGUEE_META_SECRET_APP=À COMPLÉTER
DIGUEE_META_JETON_WEBHOOK=À COMPLÉTER
DIGUEE_META_JETON_ACCES=À COMPLÉTER
DIGUEE_META_MODELE_CODE=À COMPLÉTER

# SMS (§1.6) : fournisseur à choisir ; tant qu'il manque, le serveur refuse
# de démarrer en production.
#DIGUEE_SMS=

# Stockage d'objets (§1.3).
DIGUEE_STOCKAGE=ovh
DIGUEE_OVH_S3_POINT_ACCES=https://s3.gra.io.cloud.ovh.net
DIGUEE_OVH_S3_REGION=gra
DIGUEE_OVH_S3_COMPARTIMENT=diguee-archives
DIGUEE_OVH_S3_CLE_ACCES=À COMPLÉTER
DIGUEE_OVH_S3_CLE_SECRETE=À COMPLÉTER

# Responsable du traitement, contacts, calendrier (§2).
DIGUEE_STRUCTURE_NOM=À COMPLÉTER
DIGUEE_STRUCTURE_ADRESSE=À COMPLÉTER
DIGUEE_CONTACT=À COMPLÉTER
DIGUEE_NUMERO_CDP=À COMPLÉTER
DIGUEE_NUMERO_WHATSAPP=À COMPLÉTER
DIGUEE_OUVERTURE=À COMPLÉTER
DIGUEE_ADRESSE_REPONSE=À COMPLÉTER
# Fichier lisible par le service (0644), par exemple :
DIGUEE_POPULATION_ANSD=À COMPLÉTER
