# /etc/diguee/migrations.env : seulement pour diguee-migrer.service (root
# 0600). Rôle propriétaire, par le socket Unix, « peer » : utilisateur
# système diguee-migrations → diguee_proprietaire. Absent de l'environnement
# du serveur.
DIGUEE_POSTGRES_URL_MIGRATIONS=postgres://diguee_proprietaire@/diguee?host=/var/run/postgresql
