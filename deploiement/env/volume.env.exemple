# /etc/diguee/volume.env : déverrouillage du volume chiffré
# (diguee-volume.service et volume.sh), root 0600.
# Même KMS que l'empreinte, mais une clé symétrique et une identité propres
# (certificat d'accès qui n'a que le droit de déchiffrer cette clé).
DIGUEE_OVH_KMS_POINT_ACCES=https://eu-west-par.okms.ovh.net
DIGUEE_OVH_KMS_ID=À COMPLÉTER
DIGUEE_OVH_KMS_VOLUME_CLE_ID=À COMPLÉTER
DIGUEE_OVH_KMS_VOLUME_CERTIFICAT=/etc/diguee/kms-volume.pem
DIGUEE_OVH_KMS_VOLUME_CLE_CLIENT=/etc/diguee/kms-volume.key
#DIGUEE_OVH_KMS_AC=
# Volume sur un disque additionnel plutôt que dans un fichier :
#DIGUEE_VOLUME_SOURCE=/dev/sdb
