// Diguee (ticket #7) : en plus de 50unattended-upgrades (dépôts de sécurité
// seulement), redémarrage automatique si une mise à jour l'exige (noyau,
// bibliothèques), à 04:30 UTC (04:30 à Dakar), loin de la publication de
// 06:00. Le volume se déverrouille seul au redémarrage (KMS) ; à défaut,
// procédure de secours (deploiement/README.md).
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
Unattended-Upgrade::Automatic-Reboot-Time "04:30";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::SyslogEnable "false";
